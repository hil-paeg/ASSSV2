generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// ...existing code...
model Message {
  id         Int      @id @default(autoincrement())
  message    String?
  sender     String   // new: "admin" or "client" or user id
  recipient  String?  // optional: recipient id/role
  createdAt  DateTime @default(now())
}
